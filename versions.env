# Pinned versions. The renderer (prismarine-viewer 1.33.0) only understands Minecraft <= 1.21.4
# chunk data, and its prebuilt browser bundle matches early-2025 libraries, so the whole pipeline
# runs on 1.21.1 with mineflayer 4.26.0 (package.json pins the rest).
MC_VERSION=1.21.1
